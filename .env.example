# MediaPulse — environment variable template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real keys.

# Google Gemini API — https://aistudio.google.com/apikey
# Used for: AI movie personality generation (server-side only)
GEMINI_API_KEY=

# TMDB API — https://www.themoviedb.org/settings/api
# Used for: movie discovery and recommendations (server-side only)
TMDB_API_KEY=